{
  "name": "stealth-interview-app",
  "version": "2.0.0",
  "description": "Screen-hidden AI interview assistant — local Ollama models + continuous voice recognition",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "ffmpeg-static": "^5.3.0",
    "htm": "^3.1.1",
    "pdf-parse": "1.1.4",
    "preact": "^10.29.7"
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.stealth.interview",
    "productName": "InterviewAssist",
    "protocols": {
      "name": "InterviewAssist Auth Callback",
      "schemes": [
        "interviewassist"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
