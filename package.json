{
  "name": "VijayamAI",
  "version": "2.0.0",
  "description": "Screen-hidden AI interview assistant — local Ollama models + continuous voice recognition",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "htm": "^3.1.1",
    "pdf-parse": "1.1.4",
    "preact": "^10.29.7"
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vijayamai.app",
    "productName": "vijayamAI",
    "protocols": {
      "name": "vijayamAI Auth Callback",
      "schemes": [
        "VijayamAI"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "icon_neon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
